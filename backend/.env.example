# Variables de entorno del Backend (NestJS + Prisma).
# Copiar a .env y ajustar si es necesario. Prisma las carga vía prisma7.config.ts (dotenv/config).

DATABASE_URL="postgresql://observatorio:observatorio@localhost:5432/observatorio_cr?schema=public"
PORT=3001
CORS_ORIGIN=http://localhost:3000

# SICOP (Fase 4) no requiere credenciales: se descarga vía el ZIP mensual
# público de observatoriocomprapublica.go.cr (sin autenticación).
