# ── PostgreSQL (usado por docker-compose.yml) ───────────────────────────────
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=observatorio
POSTGRES_DB=observatorio_cr
POSTGRES_PORT=5432

# ── Backend (NestJS) — copiar estas dos también a Backend/.env ─────────────
DATABASE_URL=postgresql://observatorio:observatorio@localhost:5432/observatorio_cr
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ── Frontend (Next.js) — copiar esta también a Frontend/.env.local ─────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# SICOP (Fase 4) no requiere credenciales: se descarga vía el ZIP mensual
# público de observatoriocomprapublica.go.cr (sin autenticación). No hay
# variables de entorno propias de este módulo.
